const {RtcTokenBuilder,RtcRole}=require('agora-access-token');
module.exports=async(req,res)=>{
  const appId='648370edcd6244d7bd488f0b52edb200';
  const appCertificate=process.env.AGORA_APP_CERTIFICATE;
  const channelName=req.query.channel||'1';
  if(!appCertificate){
    return res.status(200).json({token:null,msg:'no cert set - use testing mode'});
  }
  const uid=0;
  const role=RtcRole.PUBLISHER;
  const expire=3600;
  const token=RtcTokenBuilder.buildTokenWithUid(appId,appCertificate,channelName,uid,role,expire);
  res.status(200).json({token});
}
